{
    "name": "space-chicken",
    "version": "1.0.0",
    "description": "Space Chicken - Modular Phaser 3 platformer",
    "private": true,
    "license": "SEE LICENSE IN LICENSE.txt",
    "type": "module",
    "scripts": {
        "start": "node server.cjs",
        "build:cloudflare": "node scripts/build-cloudflare.cjs",
        "deploy:cloudflare": "npm run check && npm run build:cloudflare && wrangler pages deploy dist --project-name space-chicken --branch main",
        "lint": "eslint \"**/*.{js,cjs,mjs}\" --ignore-pattern archive/ --ignore-pattern node_modules/",
        "lint:fix": "eslint \"**/*.{js,cjs,mjs}\" --fix --ignore-pattern archive/ --ignore-pattern node_modules/",
        "format": "prettier --write \"**/*.{js,cjs,json,jsonc,html,md}\" --ignore-path .prettierignore",
        "format:check": "prettier --check \"**/*.{js,cjs,json,jsonc,html,md}\" --ignore-path .prettierignore",
        "test": "node --test tests/*.test.cjs",
        "check": "npm test && npm run lint -- --max-warnings=0 && npm run format:check",
        "bot": "node scripts/play-bot.mjs",
        "bot:headed": "HEADLESS=0 node scripts/play-bot.mjs",
        "bot:watch": "HEADLESS=0 RECORD_VIDEO=1 node scripts/play-bot.mjs",
        "bot:level2": "LEVEL=2 node scripts/play-bot.mjs",
        "bot:level3": "LEVEL=3 node scripts/play-bot.mjs",
        "bot:level4": "LEVEL=4 node scripts/play-bot.mjs",
        "verify:devices": "node scripts/verify-device-matrix.mjs",
        "verify:mobile": "node scripts/verify-mobile.mjs",
        "verify:perf": "node scripts/profile-performance.mjs",
        "verify:perf-page": "node scripts/verify-performance-page.mjs",
        "playtest": "node scripts/playtest-bot.mjs",
        "playtest:headed": "HEADLESS=0 node scripts/playtest-bot.mjs",
        "jev:playtest": "node scripts/jev-playtest.mjs",
        "jev:playtest:headed": "HEADLESS=0 node scripts/jev-playtest.mjs",
        "rl:convert": "node scripts/rl/convert-jev.mjs",
        "rl:train": "python3 rl/train_bc.py",
        "rl:train-rl": "python3 rl/train_rl.py",
        "rl:rollout": "node scripts/rl/rollout.mjs",
        "rl:loop": "bash scripts/rl/loop.sh",
        "rl:play": "node scripts/rl/play-policy.mjs",
        "rl:watch": "node scripts/rl/watch-policy.mjs"
    },
    "dependencies": {
        "phaser": "3.70.0"
    },
    "devDependencies": {
        "@typesafe-ai/sdk": "^0.6.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "playwright": "^1.49.0",
        "prettier": "^3.3.3",
        "wrangler": "^4.123.0"
    },
    "engines": {
        "node": ">=20"
    }
}
